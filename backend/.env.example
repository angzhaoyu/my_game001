# Windows 双击“启动游戏服务器.bat”会自动生成 .env，无需手动复制本文件。
# 本文件主要供 Docker/手动启动和生产部署参考。
APP_ENV=development
HOST=0.0.0.0
PORT=8000
APP_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_SECONDS=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=game
DB_PASSWORD=change-me
DB_NAME=game_db
DB_CONNECT_TIMEOUT_SECONDS=5

# 微信公众平台小游戏 AppID/Secret；Secret 只能放服务端环境变量。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

ENABLE_PASSWORD_AUTH=true
ALLOW_DEMO_SEED=true
ALLOWED_ORIGINS=http://localhost:7456,http://127.0.0.1:7456
