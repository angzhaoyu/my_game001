{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": []
  },
  "include": [
    "scripts/core/**/*.ts",
    "scripts/login/**/*.ts",
    "scripts/farm/**/*.ts",
    "typings/**/*.d.ts"
  ]
}
